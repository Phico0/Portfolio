<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Portfolio Figma</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      background-color: #111;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      font-family: Arial, sans-serif;
    }
    #figma-frame {
      width: 90vw;
      height: 90vh;
      border: none;
      border-radius: 10px;
      box-shadow: 0 0 30px rgba(0,0,0,0.5);
      transition: all 0.3s ease;
    }
    .nav-buttons {
      position: fixed;
      top: 50%;
      width: 100%;
      display: flex;
      justify-content: space-between;
      transform: translateY(-50%);
      pointer-events: none;
    }
    .nav-buttons button {
      pointer-events: all;
      background: rgba(255,255,255,0.3);
      border: none;
      font-size: 2rem;
      padding: 10px 20px;
      cursor: pointer;
      border-radius: 5px;
      transition: background 0.3s;
    }
    .nav-buttons button:hover {
      background: rgba(255,255,255,0.6);
    }
  </style>
</head>
<body>

  <!-- Embed Figma -->
  <iframe id="figma-frame" 
    src="https://www.figma.com/deck/dsP93cD7sf6FeHXbyp82uR/Portfolio?node-id=1-9&t=0wKIH04Qs4MpEGxO-1" 
    allowfullscreen>
  </iframe>

  <!-- Navegação -->
  <div class="nav-buttons">
    <button id="prev">&#8592;</button>
    <button id="next">&#8594;</button>
  </div>

  <script>
    const iframe = document.getElementById("figma-frame");
    const prevBtn = document.getElementById("prev");
    const nextBtn = document.getElementById("next");

    // Para protótipos do Figma: navegação por teclado ou botões
    document.addEventListener("keydown", (e) => {
      if(e.key === "ArrowLeft") {
        iframe.contentWindow.postMessage({ pluginMessage: { type: 'PREV_FRAME' }}, '*');
      }
      if(e.key === "ArrowRight") {
        iframe.contentWindow.postMessage({ pluginMessage: { type: 'NEXT_FRAME' }}, '*');
      }
    });

    prevBtn.addEventListener("click", () => {
      iframe.contentWindow.postMessage({ pluginMessage: { type: 'PREV_FRAME' }}, '*');
    });

    nextBtn.addEventListener("click", () => {
      iframe.contentWindow.postMessage({ pluginMessage: { type: 'NEXT_FRAME' }}, '*');
    });
  </script>

</body>
</html>
